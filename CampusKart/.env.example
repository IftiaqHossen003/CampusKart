# ─────────────────────────────────────────────────────────────────────────────
# CampusKart — environment variables
# Copy this file to .env and fill in the values before running the project.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_SETTINGS_MODULE=CampusKart.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=True

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=campuskart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tamim01815
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=django-db

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@campuskart.com

# ── Payment Gateways ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_SERVER_KEY=your-firebase-server-key

# ── Sentry (prod error tracking) ─────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Media / Storage ───────────────────────────────────────────────────────────
# Set to 's3' to use AWS S3 in production
MEDIA_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# ── Logging ──────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log
